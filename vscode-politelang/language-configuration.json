{
  "comments": {
    "lineComment": "--"
  },
  "brackets": [
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string"] },
    { "open": "{", "close": "}", "notIn": ["comment"] }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["\"", "\""],
    ["{", "}"]
  ],
  "indentationRules": {
    "increaseIndentPattern": ":\\s*(--.*)?$",
    "decreaseIndentPattern": "^\\s*(thanks|thank you|otherwise)\\b"
  },
  "onEnterRules": [
    {
      "beforeText": ":\\s*(--.*)?$",
      "action": { "indent": "indent" }
    }
  ],
  "wordPattern": "[A-Za-z_][A-Za-z0-9_]*"
}
