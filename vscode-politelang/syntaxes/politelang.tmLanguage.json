{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "PoliteLang",
  "scopeName": "source.polite",
  "_generated": "by `polite grammar` from vocabulary/core.vocab — do not edit by hand",
  "patterns": [
    { "include": "#comments" },
    { "include": "#text" },
    { "include": "#courtesy" },
    { "include": "#structure" },
    { "include": "#literals" },
    { "include": "#numbers" },
    { "include": "#vocabulary" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-dash.polite", "match": "--.*$" },
        { "name": "comment.line.by-the-way.polite", "match": "(?i)^\\s*by the way.*$" }
      ]
    },
    "text": {
      "name": "string.quoted.double.polite",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "name": "constant.character.escape.polite", "match": "\\\\." },
        { "name": "variable.other.interpolated.polite", "match": "\\{[^}]*\\}" }
      ]
    },
    "courtesy": {
      "name": "keyword.control.courtesy.polite",
      "match": "(?i)\\b(please|kindly|thanks|thank you|would you|if you would|be so kind|for repeating|for checking|for defining|for trying|for that)\\b"
    },
    "structure": {
      "name": "keyword.control.polite",
      "match": "(?i)\\b(define|otherwise|check if|see whether|when|try to|give back|hand back|answer with|share|use|borrow|with|and|or|not|is|is not|is over|is under|is at least|is at most|is between)\\b"
    },
    "literals": {
      "name": "constant.language.polite",
      "match": "(?i)\\b(yes|no|nothing)\\b"
    },
    "numbers": {
      "name": "constant.numeric.polite",
      "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
    },
    "vocabulary": {
      "name": "support.function.polite",
      "match": "(?i)\\b(correlation|determinant|exponential|hexadecimal|everything|hyperbolic|percentage|conjugate|direction|exclusive|factorial|imaginary|logarithm|magnitude|remainder|repeating|transpose|capitals|contains|contents|divisors|fraction|greatest|identity|mentions|multiple|multiply|pairwise|position|remember|repeated|smallest|variance|arrange|average|between|biggest|bitwise|changed|complex|decimal|degrees|display|divided|divides|factors|forever|inverse|letters|natural|percent|product|radians|reverse|rounded|seconds|shifted|smaller|squared|tangent|trimmed|version|whether|written|across|answer|append|binary|borrow|bottom|called|canvas|change|choose|circle|colour|common|cosine|divide|enough|evenly|factor|forget|height|larger|length|letter|lookup|matrix|median|number|pieces|places|random|remove|repeat|return|reveal|scaled|sorted|spread|square|starts|things|update|window|within|about|along|angle|break|check|clear|count|cross|cubed|empty|every|first|going|green|items|knows|leave|paint|piece|point|power|prime|print|right|share|small|split|there|times|total|until|value|while|whole|whose|width|words|write|back|base|blue|cube|down|draw|each|ends|file|fill|from|give|hand|have|into|item|join|keep|kept|keys|last|left|line|list|long|look|loop|make|many|mode|move|next|note|open|over|part|real|rest|root|save|show|sign|sine|size|skip|stop|take|tell|text|that|this|time|wait|ways|when|with|add|and|are|ask|box|dot|for|how|let|new|not|now|one|out|put|red|say|see|set|sum|the|top|use|an|as|at|be|by|do|if|in|is|me|of|or|pi|to|up|a|e)\\b"
    }
  }
}
