{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "PoliteLang",
  "scopeName": "source.polite",
  "_generated": "by `polite grammar` from vocabulary/core.vocab — do not edit by hand",
  "patterns": [
    { "include": "#comments" },
    { "include": "#text" },
    { "include": "#courtesy" },
    { "include": "#structure" },
    { "include": "#literals" },
    { "include": "#numbers" },
    { "include": "#vocabulary" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-dash.polite", "match": "--.*$" },
        { "name": "comment.line.by-the-way.polite", "match": "(?i)^\\s*by the way.*$" }
      ]
    },
    "text": {
      "name": "string.quoted.double.polite",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "name": "constant.character.escape.polite", "match": "\\\\." },
        { "name": "variable.other.interpolated.polite", "match": "\\{[^}]*\\}" }
      ]
    },
    "courtesy": {
      "name": "keyword.control.courtesy.polite",
      "match": "(?i)\\b(please|kindly|thanks|thank you|would you|if you would|be so kind|for repeating|for checking|for defining|for trying|for that)\\b"
    },
    "structure": {
      "name": "keyword.control.polite",
      "match": "(?i)\\b(define|otherwise|check if|see whether|when|try to|give back|hand back|answer with|share|use|borrow|with|and|or|not|is|is not|is over|is under|is at least|is at most|is between)\\b"
    },
    "literals": {
      "name": "constant.language.polite",
      "match": "(?i)\\b(yes|no|nothing)\\b"
    },
    "numbers": {
      "name": "constant.numeric.polite",
      "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
    },
    "vocabulary": {
      "name": "support.function.polite",
      "match": "(?i)\\b(correlation|determinant|exponential|hexadecimal|everything|hyperbolic|percentage|conjugate|direction|exclusive|factorial|imaginary|logarithm|magnitude|remainder|repeating|transpose|announce|capitals|channels|contains|contents|divisors|fraction|greatest|happened|identity|mentions|multiple|multiply|nickname|pairwise|position|reaction|remember|repeated|smallest|somebody|variance|whatever|arrange|average|between|biggest|bitwise|buttons|changed|channel|command|complex|correct|decimal|degrees|discord|display|divided|divides|exactly|factors|forever|happens|inverse|joining|leaving|letters|message|minutes|natural|percent|present|pressed|product|quieten|quietly|radians|reverse|rounded|seconds|shifted|smaller|squared|tangent|trimmed|version|whether|written|across|answer|append|binary|borrow|bottom|button|called|canvas|change|choose|circle|colour|common|cosine|decode|delete|divide|enough|evenly|factor|forget|height|joined|larger|length|letter|listen|lookup|matrix|median|moment|number|people|pieces|places|random|remove|repeat|return|reveal|saying|scaled|secret|server|sorted|spread|square|starts|status|taking|things|titled|typing|update|window|within|about|along|angle|break|check|clear|count|cross|cubed|delay|emoji|empty|every|first|force|going|green|items|knows|leave|offer|paint|piece|point|power|prime|print|react|reply|right|roles|share|small|split|start|their|there|times|total|until|value|watch|while|whole|whose|width|words|write|back|base|blue|came|card|cube|down|draw|each|ends|file|fill|from|gave|give|hand|have|into|item|join|keep|kept|keys|last|left|line|list|long|look|loop|made|make|many|mode|move|name|next|note|open|over|part|post|real|rest|role|root|said|save|send|show|sign|sine|size|skip|stop|take|tell|text|that|them|they|this|time|used|wait|ways|what|when|with|add|and|are|ask|ban|bot|box|dot|for|how|let|log|new|not|now|one|out|put|red|say|see|set|sum|the|top|use|was|an|as|at|be|by|do|id|if|in|is|it|me|my|of|or|pi|to|up|a|e|i)\\b"
    }
  }
}
