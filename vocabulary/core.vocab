# ---------------------------------------------------------------------------
# The world
# ---------------------------------------------------------------------------

stmt  full      wait_for       :: wait for {value} seconds
stmt  working   append_file    :: append {value} to the file {path} :: risky
stmt  working   stop_everything :: stop everything


# ---------------------------------------------------------------------------
# More ways to say what you already could
#
# Spec 4.1: a synonym costs one row and nothing else. This is what a large vocabulary is made of.
# ---------------------------------------------------------------------------

stmt  everyday  show           :: have a look at {value}
stmt  everyday  remember       :: remember that {name} is {value}
stmt  everyday  assign         :: update {name} to {value}
stmt  everyday  give_back      :: return {value}
stmt  everyday  stop_repeating :: enough of that
block everyday  check          :: if {cond}
block everyday  loop_each      :: look at every {var} in {list}
block working   loop_while     :: for as long as {cond}


# ---------------------------------------------------------------------------
# Full arithmetic
#
# The two constants are written `the number pi` and `the number e` rather than as bare words, so
# that nobody who remembers a value under one of those names is quietly overruled by a constant.
# ---------------------------------------------------------------------------

expr  working   number_pi      :: the number pi
expr  full      number_e       :: the number e

expr  working   sine_of        :: the sine of {value}
expr  working   cosine_of      :: the cosine of {value}
expr  working   tangent_of     :: the tangent of {value}
expr  full      arc_sine_of    :: the angle whose sine is {value} :: risky
expr  full      arc_cosine_of  :: the angle whose cosine is {value} :: risky
expr  full      arc_tangent_of :: the angle whose tangent is {value}
expr  full      angle_over     :: the angle of {up} over {across}
expr  working   to_degrees     :: {value} in degrees :: tight
expr  working   to_radians     :: {value} in radians :: tight

expr  full      hyperbolic_sine    :: the hyperbolic sine of {value}
expr  full      hyperbolic_cosine  :: the hyperbolic cosine of {value}
expr  full      hyperbolic_tangent :: the hyperbolic tangent of {value}

expr  working   natural_logarithm  :: the natural logarithm of {value} :: risky
expr  working   common_logarithm   :: the common logarithm of {value} :: risky
expr  full      logarithm_in_base  :: the logarithm of {value} in base {base} :: risky
expr  working   exponential_of     :: the exponential of {value}

expr  working   cube_root_of   :: the cube root of {value}
expr  everyday  squared        :: {value} squared :: tight
expr  everyday  cubed          :: {value} cubed :: tight

expr  working   whole_part_of      :: the whole part of {value}
expr  working   fraction_part_of   :: the fraction part of {value}
expr  working   sign_of            :: the sign of {value}
expr  everyday  rounded_to         :: {value} rounded to {places} decimal places
expr  everyday  kept_between       :: {value} kept between {low} and {high}

expr  working   greatest_common_factor   :: the greatest common factor of {first} and {second}
expr  working   smallest_common_multiple :: the smallest common multiple of {first} and {second} :: risky
expr  working   factorial_of             :: the factorial of {value} :: risky

expr  working   median_of          :: the median of {list} :: risky
expr  full      spread_of          :: the spread of {list} :: risky
expr  everyday  as_percentage_of   :: {part} as a percentage of {whole} :: risky
expr  everyday  percent_of         :: {percent} percent of {value} :: tight


# ---------------------------------------------------------------------------
# Fractions
#
# A fraction is exact. A third really is a third, and three of them make one, which is something
# no decimal number can honestly say.
# ---------------------------------------------------------------------------

expr  everyday  make_fraction  :: {top} over {bottom} :: risky tight
expr  everyday  make_fraction  :: the fraction {top} over {bottom} :: risky
expr  working   top_of         :: the top of {value}
expr  working   bottom_of      :: the bottom of {value}
expr  working   as_fraction    :: {value} as a fraction
expr  working   as_decimal     :: {value} as a decimal
expr  working   as_whole_number :: {value} as a whole number
expr  working   whole_number_in :: the whole number in {value} :: risky


# ---------------------------------------------------------------------------
# Complex numbers
#
# Written the way they are read: three plus the imaginary number four is 3+4i.
# ---------------------------------------------------------------------------

expr  full      imaginary_number   :: the imaginary number {value}
expr  full      real_part          :: the real part of {value}
expr  full      imaginary_part     :: the imaginary part of {value}
expr  full      conjugate_of       :: the conjugate of {value}
expr  full      direction_of       :: the direction of {value}
expr  full      complex_square_root :: the complex square root of {value}


# ---------------------------------------------------------------------------
# Whole numbers, in and out
# ---------------------------------------------------------------------------

expr  working   is_prime       :: {value} is prime
expr  working   prime_factors  :: the prime factors of {value}
expr  working   divisors_of    :: the divisors of {value}
expr  full      power_within   :: {value} to the power {power} within {modulus} :: risky tight
expr  full      inverse_within :: the inverse of {value} within {modulus} :: risky

expr  working   ways_to_choose  :: the ways to choose {count} from {total} :: risky
expr  working   ways_to_arrange :: the ways to arrange {count} from {total} :: risky


# ---------------------------------------------------------------------------
# Other ways of writing a number
# ---------------------------------------------------------------------------

expr  working   in_binary       :: {value} in binary :: tight
expr  working   in_hexadecimal  :: {value} in hexadecimal :: tight
expr  full      in_base         :: {value} in base {base} :: risky tight
expr  full      value_of_in_base :: the value of {text} in base {base} :: risky


# ---------------------------------------------------------------------------
# Bits
# ---------------------------------------------------------------------------

expr  full      bitwise_and    :: {first} bitwise and {second}
expr  full      bitwise_or     :: {first} bitwise or {second}
expr  full      bitwise_exclusive_or :: {first} bitwise exclusive or {second}
expr  full      bitwise_not    :: the bitwise not of {value}
expr  full      shifted_left   :: {value} shifted left by {count} :: tight
expr  full      shifted_right  :: {value} shifted right by {count} :: tight


# ---------------------------------------------------------------------------
# More statistics
# ---------------------------------------------------------------------------

expr  working   mode_of        :: the mode of {list} :: risky
expr  working   variance_of    :: the variance of {list} :: risky
expr  full      correlation_of :: the correlation of {first} and {second} :: risky


# ---------------------------------------------------------------------------
# Vectors and matrices
#
# A vector is a list of numbers and a matrix is a list of those lists, so there is no new kind of
# thing to learn: the rows really are rows.
# ---------------------------------------------------------------------------

expr  working   pairwise_sum     :: the pairwise sum of {first} and {second} :: risky
expr  working   pairwise_product :: the pairwise product of {first} and {second} :: risky
expr  working   dot_product      :: the dot product of {first} and {second} :: risky
expr  full      cross_product    :: the cross product of {first} and {second} :: risky
expr  working   magnitude_of     :: the magnitude of {list}
expr  working   scaled_by        :: {list} scaled by {factor}

expr  full      matrix_product   :: the matrix product of {first} and {second} :: risky
expr  full      transpose_of     :: the transpose of {matrix} :: risky
expr  full      determinant_of   :: the determinant of {matrix} :: risky
expr  full      matrix_inverse   :: the inverse matrix of {matrix} :: risky
expr  full      identity_matrix  :: the identity matrix of size {size} :: risky


# ---------------------------------------------------------------------------
# Drawing
#
# A terminal is a grid of cells, and one cell can hold two dots: the top painted as the letter and
# the bottom as the ground behind it. So the language really does draw, with nothing fetched and
# no window asked for.
#
# A place on the canvas is a point, which is a list of two numbers. A colour is a whole number,
# made either from its three parts or by its name.
# ---------------------------------------------------------------------------

stmt  working   open_canvas    :: open a canvas {wide} across and {tall} down
stmt  working   clear_canvas   :: clear the canvas to {colour}
stmt  working   paint_point    :: paint {where} in {colour}
stmt  working   draw_line      :: draw a line from {start} to {finish} in {colour}
stmt  working   draw_box       :: draw a box from {start} to {finish} in {colour}
stmt  working   fill_box       :: fill a box from {start} to {finish} in {colour}
stmt  working   draw_circle    :: draw a circle at {middle} of size {radius} in {colour}
stmt  working   reveal_canvas  :: reveal the canvas
stmt  full      reveal_letters :: reveal the letters of the canvas

expr  working   a_point        :: the point {across} and {down}
expr  working   make_colour    :: the colour with red {red} green {green} blue {blue}
expr  working   named_colour   :: the colour called {shade} :: risky
expr  working   canvas_width   :: the canvas width
expr  working   canvas_height  :: the canvas height
expr  full      colour_at      :: the colour at {where}


# ---------------------------------------------------------------------------
# Pictures that leave the terminal
#
# A canvas can be written out as a real picture file, which anything at all can open, and shown in
# a window rather than in a terminal. The window follows the canvas by itself: draw again and it
# is seen again, without anybody reaching for the keyboard.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Discord
#
# A bot waits to be spoken to, and answers. It is written as a loop rather than as a pile of
# handlers, because a loop is what it is: listen, look at what was said, say something back.
#
# None of this works in the reference runner, which has no network and does not want one. Write the
# program out as JavaScript with `polite build` and run it with node, where a world full of
# libraries is already sitting there.
#
# A token is not written in the program. `the secret called "..."` reads it from the surroundings,
# so a bot can be shown to anybody without handing them the keys to it.
# ---------------------------------------------------------------------------

stmt  working   discord_log_in :: log in to discord with {token} :: risky
stmt  working   discord_next   :: listen for the next message :: risky
stmt  working   discord_reply  :: reply with {text} :: risky
stmt  working   discord_send   :: send {text} :: risky
stmt  working   discord_status :: let my status be {text} :: risky

expr  working   discord_said     :: what they said
expr  working   discord_name     :: their name
expr  working   discord_is_bot   :: they are a bot
expr  working   discord_channel  :: the channel it came from
expr  working   discord_server   :: the server it came from
expr  working   secret_called    :: the secret called {which} :: risky

# ---------------------------------------------------------------------------
# Text that hides what it says
#
# Writing kept in base sixty-four, in hexadecimal, or in backslash escapes says nothing to the
# person reading the file and everything to the machine running it, which is how something nasty
# usually travels inside something harmless. So it is decoded on sight and said out loud, and the
# decoded writing is what the program gets.
#
# Hiding is still allowed. It just cannot be done quietly any more: it has to be asked for, in
# words, on the line where it happens, where anybody reading the file will see it.
# ---------------------------------------------------------------------------

expr  working   not_decoded    :: force not to decode {text}
expr  working   not_decoded    :: leave {text} exactly as it is
expr  working   not_decoded    :: {text} as it is written

stmt  working   write_text     :: write {words} at {where} in {colour}
stmt  working   letter_size    :: make the letters {size} across
expr  working   written_width  :: the width of {words} written
stmt  working   save_canvas    :: save the canvas to {path} :: risky
stmt  working   put_in_window  :: put the canvas in a window :: risky
stmt  working   dot_size       :: make each dot {size} across

# ---------------------------------------------------------------------------
# Explanations, for `polite explain` (spec 4.4). The English meaning comes first, because
# purpose 1 of the language is that you learn more English.
# ---------------------------------------------------------------------------

explain show           :: To show something is to let it be seen. This puts a value on the screen.
explain ask_as         :: To ask is to request an answer. This waits for the person to type something, and remembers it under the name you give.
explain remember       :: To remember something is to keep it in mind. This introduces a new name and gives it a value.
explain assign         :: To change something is to make it different. This gives an existing name a new value.
explain add_to         :: To add is to join one thing to another. With a number it counts up; with a list it puts an item on the end; with text it joins the text on.
explain take_from      :: To take from is to remove. This counts a number down.
explain multiply_by    :: To multiply is to add a number to itself a given number of times.
explain divide_by      :: To divide is to share a number into equal parts. It might not work out, because nothing can be shared into zero parts.
explain loop_count     :: To repeat is to do the same thing again. This does the block a set number of times.
explain loop_while     :: While means during the time that something is true. This keeps doing the block for as long as the condition holds.
explain loop_until     :: Until means up to the moment something becomes true. This keeps doing the block until the condition holds.
explain loop_forever   :: This keeps doing the block with no end of its own. Use `stop repeating` to leave.
explain loop_each      :: This does the block once for every item in a list, giving each one the name you chose.
explain loop_range     :: This counts from one number up to another, doing the block once for each.
explain stop_repeating :: To stop repeating is to leave the loop you are inside and carry on after it.
explain skip_one       :: This abandons the current turn around the loop and starts the next one.
explain check          :: To check is to look and see. This does the block only if the condition is true.
explain give_back      :: To give back is to return something to whoever asked. This ends the action and hands over a value.
explain empty_list     :: A list is a row of things kept in order. This makes one with nothing in it yet.
explain item_of        :: This takes one item out of a list by its position, counting from 1. It might not work out, because the list may be shorter than that.
explain count_of       :: This is how many items a list is holding.
explain first_item     :: The first item is the one at the front. It might not work out, because the list may be empty.
explain last_item      :: The last item is the one at the back. It might not work out, because the list may be empty.
explain sum_of         :: To sum is to add everything together. This adds up all the numbers in a list.
explain biggest_of     :: This is the largest number in a list. It might not work out, because an empty list has no largest.
explain smallest_of    :: This is the smallest number in a list. It might not work out, because an empty list has no smallest.
explain sorted_of      :: To sort is to put in order. This gives back a new list in order, leaving the original alone.
explain reverse_of     :: To reverse is to turn back to front. This gives back a new list the other way round.
explain join_of        :: To join is to bring together. This glues every item of a list into one piece of text, with the separator between them.
explain contains_item  :: To contain is to hold within. This is yes when the list holds that item.
explain position_of    :: This is where an item sits in a list, counting from 1. It might not work out, because the item may not be there.
explain put_at         :: This replaces the item at a position. It might not work out, because the list may be shorter than that.
explain remove_at      :: This takes the item at a position out of the list. It might not work out, because the list may be shorter than that.
explain empty_lookup   :: A lookup holds values you find by name, the way a dictionary finds a meaning by its word. This makes one with nothing in it yet.
explain value_for      :: This finds the value stored under a key. It might not work out, because nothing may be stored there.
explain keys_of        :: These are all the names a lookup knows about, as a list.
explain has_key        :: This is yes when the lookup has something stored under that key.
explain put_for        :: This stores a value in a lookup under a key, so you can find it again by that name.
explain forget_key     :: To forget is to stop keeping in mind. This removes a key and its value from a lookup.
explain length_of      :: The length of text is how many letters it has.
explain capitals_of    :: Capitals are the big letters. This gives back the same text in capitals.
explain small_of       :: This gives back the same text in small letters.
explain trimmed_of     :: To trim is to cut off the edges. This removes spaces from the start and end of text.
explain words_in       :: This breaks text apart wherever there are spaces, and gives back the words as a list.
explain split_of       :: To split is to break into pieces. This breaks text apart wherever the separator appears.
explain number_in      :: This reads text as a number. It might not work out, because the text may not be a number at all.
explain text_of        :: This turns any value into text, so it can be joined with other text.
explain starts_with    :: This is yes when text begins with the piece you named.
explain ends_with      :: This is yes when text finishes with the piece you named.
explain contains_text  :: To mention is to refer to. This is yes when the piece appears anywhere in the text.
explain random_range   :: Random means chosen with no pattern. This picks a whole number between two limits, including both.
explain rounded_of     :: To round is to bring to the nearest whole number.
explain absolute_of    :: The size of a number ignores whether it is above or below zero.
explain square_root_of :: The square root is the number which, times itself, gives you this one. It might not work out, because numbers below zero have none.
explain divides_evenly :: This is yes when one number goes into another leaving nothing over. Nothing divides evenly by zero, so that answer is simply no.
explain contents_of    :: This reads a whole file as text. It might not work out, because the file may not be there.
explain write_file     :: This writes text into a file, replacing whatever was there. It might not work out, because the place may not be writable.
explain file_exists    :: This is yes when there really is a file at that place.
explain time_now       :: This is the number of seconds since the start of 1970, which is how computers usually count time.
explain use_module     :: To borrow is to take with the intention of giving back. This brings another file's shared words into yours.
explain share          :: To share is to offer to others. A file keeps everything to itself unless it shares it.
explain slice_of       :: A piece of text is any run of letters within it. This takes the run between two positions, counting from 1.
explain replace_in     :: To change one thing to another is to put the second where the first was. This gives back the text with every one of them swapped.
explain letter_of      :: This takes a single letter out of some text by its position, counting from 1. It might not work out, because the text may be shorter than that.
explain letters_of     :: This breaks text into its letters, one after another, as a list.
explain repeated_text  :: To repeat is to do again. This gives back the text written out over and over.
explain is_empty       :: Something is empty when there is nothing in it at all. This works for text, for lists and for lookups.
explain remainder_of   :: The remainder is what is left over when one number is shared into another as far as it will go. It might not work out, because nothing can be shared into zero parts.
explain smaller_of     :: This is whichever of two numbers is the lesser.
explain larger_of      :: This is whichever of two numbers is the greater.
explain power_of       :: To raise to a power is to multiply a number by itself that many times.
explain rounded_down   :: To round down is to go to the whole number below, however close the next one is.
explain rounded_up     :: To round up is to go to the whole number above, however far away it is.
explain rest_of        :: The rest is everything after the first item. An empty list has an empty rest, which is no trouble at all.
explain first_few      :: This takes as many items from the front of a list as you asked for, or all of them if there are fewer.
explain average_of     :: The average is the total shared equally between all of them. It might not work out, because an empty list has nothing to share.
explain count_in       :: This is how many times something appears in a list.
explain lookup_count   :: This is how many things a lookup is holding.
explain wait_for       :: To wait is to let time pass without doing anything. This pauses the program for a while.
explain append_file    :: To append is to add to the end. This puts text at the end of a file, leaving what was already there. It might not work out, because the place may not be writable.
explain stop_everything :: This ends the whole program at once. Nothing catches it, which is exactly why it is there.
explain number_pi      :: Pi is how many times across a circle goes into the way round it, a little over three.
explain number_e       :: The number e is the one that turns up wherever something grows on its own, a little over two and a half.
explain sine_of        :: The sine of an angle is how far up you have gone, on a circle of size one. Angles here are in radians.
explain cosine_of      :: The cosine of an angle is how far across you have gone, on a circle of size one. Angles here are in radians.
explain tangent_of     :: The tangent of an angle is its sine shared by its cosine, which is the steepness of that slope.
explain arc_sine_of    :: This is the angle whose sine you gave. It might not work out, because no angle has a sine outside minus one to one.
explain arc_cosine_of  :: This is the angle whose cosine you gave. It might not work out, because no angle has a cosine outside minus one to one.
explain arc_tangent_of :: This is the angle whose tangent you gave. Every number is the tangent of some angle, so this always works out.
explain angle_over     :: Given how far up and how far across, this is the angle of the line between them, taking care of which quarter it points into.
explain to_degrees     :: A full turn is two pi radians, or three hundred and sixty degrees. This changes one into the other.
explain to_radians     :: A full turn is three hundred and sixty degrees, or two pi radians. This changes one into the other.
explain hyperbolic_sine    :: The hyperbolic sine is the sine of a hyperbola rather than a circle, which turns up in hanging chains and in growth.
explain hyperbolic_cosine  :: The hyperbolic cosine is the shape a chain makes when you hold it at both ends and let it hang.
explain hyperbolic_tangent :: The hyperbolic tangent squashes any number at all into the range between minus one and one.
explain natural_logarithm  :: The natural logarithm asks what power the number e must be raised to. It might not work out, because nothing raised to a power gives zero or less.
explain common_logarithm   :: The common logarithm asks what power ten must be raised to. It might not work out, because nothing raised to a power gives zero or less.
explain logarithm_in_base  :: This asks what power the base must be raised to. It might not work out, because of zero, of numbers below it, and of a base of one.
explain exponential_of     :: This is the number e raised to the power you gave, which is the undoing of the natural logarithm.
explain cube_root_of   :: The cube root is the number which, times itself and times itself again, gives you this one. Numbers below zero have one too.
explain squared        :: To square a number is to multiply it by itself.
explain cubed          :: To cube a number is to multiply it by itself and by itself again.
explain whole_part_of      :: The whole part is what is left when the bit after the dot is thrown away, without rounding either way.
explain fraction_part_of   :: The fraction part is the bit after the dot, on its own.
explain sign_of            :: The sign is one for a number above zero, minus one for a number below it, and zero for zero itself.
explain rounded_to         :: This rounds to as many places after the dot as you asked for.
explain kept_between       :: To keep something between two ends is to bring it back to the nearer end whenever it strays outside them.
explain greatest_common_factor   :: The greatest common factor is the largest number that goes evenly into both.
explain smallest_common_multiple :: The smallest common multiple is the smallest number that both go evenly into. It might not work out, because zero has no multiples to speak of.
explain factorial_of             :: The factorial is every whole number from one up to this one, all multiplied together. It might not work out, because it grows faster than I can hold.
explain median_of          :: The median is the one in the middle once they are put in order, which is a fairer average when one of them is wildly out. It might not work out, because an empty list has no middle.
explain spread_of          :: The spread says how far from the average the numbers usually sit. It might not work out, because an empty list has no spread.
explain as_percentage_of   :: This is how many hundredths of the whole the part comes to. It might not work out, because nothing is a share of zero.
explain percent_of         :: A percentage is a number of hundredths. This takes that many hundredths of a value.
explain make_fraction  :: A fraction is one whole number shared into another, kept exact for ever. It might not work out, because nothing can be shared into zero parts.
explain top_of         :: The top of a fraction is the number above the line, once the fraction is in its smallest form.
explain bottom_of      :: The bottom of a fraction is the number below the line, once the fraction is in its smallest form.
explain as_fraction    :: This finds the fraction a person would have written for a number, so three quarters comes back as three quarters rather than as something enormous.
explain as_decimal     :: This works a number out as a decimal, which may lose a little of a fraction but is often what you want to show.
explain as_whole_number :: This throws away anything after the dot, without rounding either way.
explain whole_number_in :: This reads text as a whole number of any size at all. It might not work out, because the text may not be a whole number.
explain imaginary_number :: An imaginary number is a number of steps up rather than across. One of them, times itself, is minus one.
explain real_part        :: The real part is how far across a complex number sits.
explain imaginary_part   :: The imaginary part is how far up a complex number sits.
explain conjugate_of     :: The conjugate of a complex number is the same distance across and the same distance the other way up.
explain direction_of     :: This is the way a complex number points, as an angle in radians.
explain complex_square_root :: Every number has a square root once the imaginary ones are allowed, so this one always works out.
explain is_prime       :: A prime is a whole number above one that nothing but one and itself goes into evenly.
explain prime_factors  :: These are the primes that multiply together to make this number, smallest first and repeated as often as they appear.
explain divisors_of    :: These are all the whole numbers that go evenly into this one, in order.
explain power_within   :: This raises a number to a power but only ever keeps the remainder within a modulus, so the working stays small however large the power is. It might not work out, because a modulus has to be above zero.
explain inverse_within :: This is the number which, times the one you gave, leaves one within the modulus. It might not work out, because the two may share a factor.
explain ways_to_choose  :: This is how many ways there are to pick that many things out of a group, when the order you pick them in does not matter.
explain ways_to_arrange :: This is how many ways there are to pick that many things out of a group and put them in order.
explain in_binary       :: Binary writes a number using only ones and zeroes, which is how a machine holds it.
explain in_hexadecimal  :: Hexadecimal writes a number using sixteen digits rather than ten, with a to f standing for ten to fifteen.
explain in_base         :: This writes a number using however many digits you ask for. It might not work out, because two to thirty six is as far as the digits go.
explain value_of_in_base :: This reads text written in some base and gives back the number. It might not work out, because the text may hold a digit that base does not have.
explain bitwise_and    :: This keeps only the bits that are set in both numbers.
explain bitwise_or     :: This keeps every bit that is set in either number.
explain bitwise_exclusive_or :: This keeps the bits that are set in one number or the other, but not in both.
explain bitwise_not    :: This turns every bit the other way round.
explain shifted_left   :: Shifting left moves every bit up, which doubles the number once for each place.
explain shifted_right  :: Shifting right moves every bit down, which halves the number once for each place.
explain mode_of        :: The mode is the one that turns up most often. Where several tie, this gives the smallest of them. It might not work out, because in an empty list nothing turns up at all.
explain variance_of    :: The variance says how far from the average the numbers usually sit, before the square root that makes it a spread. It might not work out, because an empty list has none.
explain correlation_of :: This says how closely two lists move together, from minus one for opposite to one for exactly together. It might not work out, because the lists have to be the same length and to change at all.
explain pairwise_sum     :: This adds two lists item by item. It might not work out, because they have to be the same length.
explain pairwise_product :: This multiplies two lists item by item. It might not work out, because they have to be the same length.
explain dot_product      :: This multiplies two lists item by item and adds the lot together, which says how much they point the same way. It might not work out, because they have to be the same length.
explain cross_product    :: This is the direction at right angles to two others, which only means something in three dimensions. It might not work out, because both lists have to hold exactly three.
explain magnitude_of     :: The magnitude is how long a list of numbers is if you read it as an arrow from nothing.
explain scaled_by        :: This multiplies every item of a list by the same number.
explain matrix_product   :: This multiplies two matrices, which is how one change of space is followed by another. It might not work out, because the shapes have to meet.
explain transpose_of     :: To transpose is to turn on its side: the rows become columns. It might not work out, because the rows all have to be the same length.
explain determinant_of   :: The determinant says how much a matrix stretches space. Nothing means it flattens it. It might not work out, because only a square matrix has one.
explain matrix_inverse   :: This is the matrix that undoes the one you gave. It might not work out, because a matrix that flattens space cannot be undone.
explain identity_matrix  :: This is the square matrix that changes nothing at all, with ones down the middle and nothing anywhere else.


# ---------------------------------------------------------------------------
# English
#
# The first reason this language exists is that you should come away knowing more English than you
# started with. So every word it uses is written down here as well: what part of speech it is, and
# what it means in ordinary English, quite apart from what it does in a program.
#
# `polite explain <word>` shows both, side by side.
#
#     english <word> :: <part of speech> :: <what it means>
#
# A word may have several senses. The one the language uses comes first.
# ---------------------------------------------------------------------------

english a              :: determiner   :: Used before a naming word to mean any one of that kind, not a particular one.
english about          :: preposition  :: On the subject of; having to do with.
english add            :: verb         :: To put one thing together with another so that there is more of it.
english along          :: adverb       :: Onward; further forward.
english am             :: verb         :: The form of the verb to be that goes with I.
english an             :: determiner   :: The form of a used before a word that begins with a vowel sound.
english and            :: conjunction  :: Used to join two things together.
english angle          :: noun         :: The amount of turn between two lines that meet.
english answer         :: verb         :: To give a reply to a question.
english answer         :: noun         :: A reply, or the solution to a problem.
english append         :: verb         :: To add something on to the end of what is already there.
english are            :: verb         :: The form of the verb to be that goes with you, we and they.
english arrange        :: verb         :: To put things in a particular order.
english as             :: conjunction  :: In the way that; or used to give something a name.
english ask            :: verb         :: To put a question to somebody, or to request something.
english at             :: preposition  :: In or near a place, or at a particular point.
english average        :: noun         :: The total of several numbers shared equally between them.
english back           :: adverb       :: To the place or state something came from.
english base           :: noun         :: The bottom part that something stands on; of numbers, how many different digits a way of writing them uses.
english be             :: verb         :: To exist, or to have some quality.
english between        :: preposition  :: In the space or the range that separates two things.
english biggest        :: adjective    :: Larger than all the others.
english binary         :: noun         :: A way of writing numbers using only two digits, one and zero.
english binary         :: adjective    :: Having two parts.
english bitwise        :: adverb       :: Working on each single bit of a number, one at a time.
english borrow         :: verb         :: To take something for a while, meaning to give it back.
english bottom         :: noun         :: The lowest part of something; in a fraction, the number below the line.
english break          :: verb         :: To come apart, or to bring something to a sudden stop.
english by             :: preposition  :: Beside; or used to say how something is done, or by how much.
english capitals       :: noun         :: The big letters, A B C rather than a b c.
english change         :: verb         :: To make something different from what it was.
english change         :: noun         :: The act of becoming different.
english changed        :: verb         :: The past form of change.
english check          :: verb         :: To look and see whether something is so.
english choose         :: verb         :: To pick one out of several.
english common         :: adjective    :: Shared by more than one; or happening often.
english complex        :: adjective    :: Made of several joined parts; of a number, having a part above the line as well as across.
english conjugate      :: noun         :: A matching pair; of a complex number, the same distance across and the opposite way up.
english contains       :: verb         :: Holds within itself.
english contents       :: noun         :: What is held inside something.
english correlation    :: noun         :: How closely two things move together.
english cosine         :: noun         :: How far across you have gone, going round a circle of size one.
english count          :: verb         :: To say the numbers in order, or to find out how many there are.
english count          :: noun         :: A total reached by counting.
english cross          :: adjective    :: Lying across; a cross product points out of the plane of the two it comes from.
english cross          :: noun         :: A mark or shape made of two lines crossing.
english cube           :: noun         :: A solid with six square sides; also a number multiplied by itself and by itself again.
english cubed          :: verb         :: Multiplied by itself and by itself again.
english decimal        :: adjective    :: To do with tenths, and with counting in tens.
english decimal        :: noun         :: A number written with a dot and parts after it.
english define         :: verb         :: To say exactly what something means.
english degrees        :: noun         :: Units of turn. A full turn is three hundred and sixty of them.
english determinant    :: noun         :: A number saying how much a matrix stretches or flattens space.
english direction      :: noun         :: The way something points or moves.
english display        :: verb         :: To put something where it can be seen.
english display        :: noun         :: Something put out to be looked at.
english divide         :: verb         :: To share something into equal parts.
english divided        :: verb         :: The past form of divide.
english divides        :: verb         :: Goes into a number; shares into equal parts.
english divisors       :: noun         :: The whole numbers that go evenly into another number.
english do             :: verb         :: To carry something out; to perform an action.
english does           :: verb         :: The form of do that goes with he, she and it.
english dot            :: noun         :: A small round mark. A dot product multiplies two lists and adds the results together.
english down           :: adverb       :: Towards a lower place, or a lower number.
english e              :: noun         :: A particular number, a little over two and a half, that turns up wherever something grows on its own.
english empty          :: adjective    :: Having nothing at all in it.
english ends           :: verb         :: Finishes; comes to a stop.
english enough         :: determiner   :: As much as is needed, and no more.
english evenly         :: adverb       :: In equal parts, leaving nothing over.
english every          :: determiner   :: Each one of a group, without leaving any out.
english everything     :: pronoun      :: All of it; every single thing.
english exclusive      :: adjective    :: Taking one or the other but not both.
english exponential    :: adjective    :: Growing faster and faster the larger it already is.
english factor         :: noun         :: A number that goes evenly into another.
english factorial      :: noun         :: Every whole number from one up to a given number, all multiplied together.
english factors        :: noun         :: More than one factor.
english file           :: noun         :: A named piece of writing kept on a machine.
english first          :: adjective    :: Coming before all the others.
english for            :: preposition  :: Meant to be given to; or lasting a length of time.
english forever        :: adverb       :: For all time, with no end.
english forget         :: verb         :: To stop keeping something in mind.
english fraction       :: noun         :: A part of a whole, written as one number over another.
english from           :: preposition  :: Used to say where something starts.
english give           :: verb         :: To hand something over to somebody.
english going          :: verb         :: Moving along, or carrying on.
english greatest       :: adjective    :: Largest of them all.
english hand           :: verb         :: To pass something to somebody.
english hand           :: noun         :: The part of the body at the end of the arm.
english have           :: verb         :: To hold or to own.
english hexadecimal    :: noun         :: A way of writing numbers using sixteen digits rather than ten.
english how            :: adverb       :: In what way; or to what amount.
english hyperbolic     :: adjective    :: To do with a hyperbola, the curve a hanging chain makes.
english i              :: pronoun      :: The word you use when speaking of yourself.
english identity       :: noun         :: What a thing is in itself. The identity matrix is the one that changes nothing.
english if             :: conjunction  :: On the condition that.
english imaginary      :: adjective    :: Existing in the mind rather than in fact; of numbers, measured up rather than across.
english in             :: preposition  :: Inside; within.
english into           :: preposition  :: To the inside of; or used to show a change from one thing to another.
english inverse        :: noun         :: The thing that undoes another.
english inverse        :: adjective    :: Opposite in effect.
english is             :: verb         :: The form of the verb to be that goes with he, she and it.
english it             :: pronoun      :: The word for a thing already spoken of.
english item           :: noun         :: One single thing in a list.
english items          :: noun         :: More than one item.
english join           :: verb         :: To bring two things together so that they become one.
english keep           :: verb         :: To go on having something.
english kept           :: verb         :: The past form of keep.
english keys           :: noun         :: The names a lookup stores its things under.
english keys           :: noun         :: Things that open locks.
english kind           :: adjective    :: Gentle and caring towards others.
english kind           :: noun         :: A sort or type of thing.
english kindly         :: adverb       :: In a kind way; used to ask for something politely.
english knows          :: verb         :: Has in mind; is aware of.
english larger         :: adjective    :: Bigger than the other one.
english last           :: adjective    :: Coming after all the others.
english least          :: adjective    :: Smallest in amount.
english leave          :: verb         :: To go away from somewhere; to let something stay as it is.
english left           :: adjective    :: On the side opposite the right.
english left           :: verb         :: The past form of leave.
english length         :: noun         :: How long something is from end to end.
english let            :: verb         :: To allow something to happen.
english letter         :: noun         :: One of the marks that words are written with.
english letter         :: noun         :: A written message sent to somebody.
english letters        :: noun         :: More than one letter.
english list           :: noun         :: A number of things written one after another.
english list           :: verb         :: To write things out one after another.
english logarithm      :: noun         :: The power a number must be raised to in order to make another.
english long           :: adjective    :: Measuring a lot from end to end, or lasting a lot of time.
english look           :: verb         :: To turn your eyes towards something.
english lookup         :: noun         :: A store where things are found by name, the way a dictionary finds a meaning by its word.
english loop           :: noun         :: Something that comes back round to where it began.
english magnitude      :: noun         :: How large something is.
english make           :: verb         :: To bring something into being.
english many           :: determiner   :: A large number of.
english matrix         :: noun         :: Numbers set out in rows and columns.
english me             :: pronoun      :: The form of I used after a verb.
english median         :: noun         :: The middle one, once they are all put in order.
english mentions       :: verb         :: Refers to; speaks of.
english minus          :: preposition  :: Less; with the second amount taken away.
english mode           :: noun         :: The one that turns up most often.
english mode           :: noun         :: A way of doing something.
english most           :: determiner   :: The greatest amount or number.
english move           :: verb         :: To go from one place to another.
english much           :: determiner   :: A large amount of.
english multiple       :: noun         :: A number that another goes evenly into.
english multiple       :: adjective    :: More than one.
english multiply       :: verb         :: To add a number to itself a given number of times.
english natural        :: adjective    :: Belonging to nature; not made up. The natural logarithm is the one that uses the number e.
english new            :: adjective    :: Made or begun only just now.
english next           :: adjective    :: Coming immediately after this one.
english no             :: determiner   :: Not any.
english no             :: interjection :: The word used to disagree or refuse.
english not            :: adverb       :: Used to say that something is untrue or the opposite.
english note           :: verb         :: To make a record of something; to notice it.
english note           :: noun         :: A short piece of writing to remind you.
english nothing        :: pronoun      :: Not a single thing.
english now            :: adverb       :: At this moment.
english number         :: noun         :: A word or sign that says how many.
english of             :: preposition  :: Belonging to; made from; being part of.
english one            :: number       :: The first and smallest counting number.
english or             :: conjunction  :: Used to offer another possibility.
english otherwise      :: adverb       :: In the other case; if that is not so.
english out            :: adverb       :: Away from the inside.
english over           :: preposition  :: Above; or more than; or shared into, as in a fraction.
english pairwise       :: adverb       :: Taking two lists a pair at a time.
english part           :: noun         :: A piece of something larger.
english percent        :: noun         :: Out of every hundred.
english percentage     :: noun         :: An amount given as so many hundredths.
english pi             :: noun         :: How many times across a circle goes into the way round it, a little over three.
english piece          :: noun         :: A part broken or cut from a whole.
english pieces         :: noun         :: More than one piece.
english places         :: noun         :: Positions; in a decimal, the digits after the dot.
english please         :: adverb       :: A word used to ask for something politely.
english please         :: verb         :: To make somebody glad.
english plus           :: preposition  :: With the second amount added on.
english position       :: noun         :: The place where something sits.
english power          :: noun         :: The number of times a number is multiplied by itself.
english power          :: noun         :: Strength, or the ability to do something.
english prime          :: adjective    :: Of a whole number above one, having no factors but one and itself.
english prime          :: adjective    :: First in importance.
english print          :: verb         :: To put words onto paper or onto a screen.
english product        :: noun         :: The result of multiplying.
english put            :: verb         :: To place something somewhere.
english radians        :: noun         :: Units of turn. A full turn is two pi of them.
english random         :: adjective    :: Chosen with no pattern to it.
english real           :: adjective    :: Actually existing; of numbers, measured across rather than up.
english remainder      :: noun         :: What is left over.
english remember       :: verb         :: To keep something in mind.
english remove         :: verb         :: To take something away.
english repeat         :: verb         :: To do or say something again.
english repeated       :: verb         :: The past form of repeat.
english repeating      :: verb         :: Doing something again.
english rest           :: noun         :: What is left after the first part.
english rest           :: verb         :: To stop and take a break.
english return         :: verb         :: To go back, or to give something back.
english reverse        :: verb         :: To turn something back to front.
english reverse        :: noun         :: The other way round.
english right          :: adjective    :: On the side opposite the left.
english right          :: adjective    :: Correct.
english root           :: noun         :: The part a plant grows from. A square root is the number that, times itself, gives another.
english rounded        :: verb         :: Brought to the nearest whole number.
english say            :: verb         :: To speak words.
english scaled         :: verb         :: Made larger or smaller by the same amount all over.
english seconds        :: noun         :: Small units of time. Sixty of them make a minute.
english see            :: verb         :: To take something in with the eyes; also, to understand.
english set            :: verb         :: To put in place, or to give something a value.
english share          :: verb         :: To let others have some of what is yours.
english shifted        :: verb         :: Moved along from where it was.
english show           :: verb         :: To let something be seen; to put it where somebody can look at it.
english show           :: noun         :: A display put on for people to watch.
english sign           :: noun         :: A mark standing for something; of a number, whether it is above or below zero.
english sine           :: noun         :: How far up you have gone, going round a circle of size one.
english size           :: noun         :: How big something is.
english skip           :: verb         :: To pass over something without doing it.
english skip           :: verb         :: To move along with light hopping steps.
english small          :: adjective    :: Little in size or amount.
english smaller        :: adjective    :: Less big than the other one.
english smallest       :: adjective    :: Least big of them all.
english so             :: adverb       :: To such an amount.
english so             :: conjunction  :: And therefore.
english sorted         :: verb         :: Put in order.
english split          :: verb         :: To break something into parts.
english spread         :: noun         :: How far from the middle things usually sit.
english spread         :: verb         :: To open out or reach across.
english square         :: noun         :: A shape with four equal sides and four right angles.
english square         :: noun         :: A number multiplied by itself.
english squared        :: verb         :: Multiplied by itself.
english starts         :: verb         :: Begins.
english stop           :: verb         :: To bring something to an end.
english sum            :: noun         :: The result of adding things together.
english sure           :: adjective    :: Certain; having no doubt about it.
english take           :: verb         :: To get hold of something, or to remove it.
english tangent        :: noun         :: A line that touches a curve; of an angle, its sine shared by its cosine.
english tell           :: verb         :: To say something to somebody.
english text           :: noun         :: Written words.
english thank          :: verb         :: To say that you are grateful.
english thanks         :: noun         :: Words of gratitude.
english thanks         :: interjection :: A short way of saying thank you.
english that           :: determiner   :: The one already spoken of.
english that           :: pronoun      :: The thing already spoken of.
english the            :: determiner   :: Used before a naming word to mean a particular one.
english then           :: adverb       :: After that; next.
english there          :: adverb       :: In or at that place.
english things         :: noun         :: Objects or matters, spoken of generally.
english this           :: determiner   :: The one here, or the one being spoken of now.
english time           :: noun         :: What clocks measure; the passing of moments.
english times          :: preposition  :: Multiplied by.
english times          :: noun         :: The number of occasions something happens.
english to             :: preposition  :: In the direction of; as far as.
english too            :: adverb       :: More than is wanted.
english too            :: adverb       :: Also; as well.
english top            :: noun         :: The highest part; in a fraction, the number above the line.
english total          :: noun         :: The whole amount when everything is added together.
english transpose      :: verb         :: To swap things around; of a matrix, to turn the rows into columns.
english trimmed        :: verb         :: Cut back at the edges.
english trouble        :: noun         :: Difficulty, or bother caused to somebody.
english try            :: verb         :: To make an attempt at something.
english under          :: preposition  :: Below; less than.
english until          :: conjunction  :: Up to the time that.
english up             :: adverb       :: Towards a higher place, or a higher number.
english update         :: verb         :: To bring something up to date; to give it a new value.
english use            :: verb         :: To put something to work for a purpose.
english value          :: noun         :: What something is worth; the thing a name is holding.
english variance       :: noun         :: How far from the average numbers sit, before the square root that makes it a spread.
english version        :: noun         :: One form of something that comes in several.
english wait           :: verb         :: To stay where you are until something happens.
english ways           :: noun         :: Methods of doing something; or the number of different possibilities.
english went           :: verb         :: The past form of go.
english what           :: pronoun      :: Used to ask which thing is meant.
english when           :: conjunction  :: At the time that.
english whether        :: conjunction  :: Used to introduce a choice between two possibilities.
english while          :: conjunction  :: During the time that.
english whole          :: adjective    :: Complete, with nothing missing. Of a number, having nothing after the dot.
english whose          :: pronoun      :: Belonging to which person or thing.
english with           :: preposition  :: In the company of; or using.
english within         :: preposition  :: Inside the limits of.
english words          :: noun         :: The units that language is made of.
english work           :: verb         :: To do a job; or to turn out successfully.
english would          :: verb         :: Used to ask for something politely, or to speak of what might be.
english write          :: verb         :: To put words down.
english wrong          :: adjective    :: Not correct; not as it should be.
english yes            :: interjection :: The word used to agree.
english you            :: pronoun      :: The person being spoken to.
explain open_canvas    :: To open a canvas is to make a fresh surface to draw on, so many dots across and so many down. Everything drawn after this goes onto it.
explain clear_canvas   :: This washes the whole canvas over in one colour, which is how a picture usually begins.
explain paint_point    :: This colours in a single dot. A point is a list of two numbers: how far across, and how far down.
explain draw_line      :: This draws a straight line between two points, one dot at a time, with no gaps in it.
explain draw_box       :: This draws the four sides of a box between two opposite corners, leaving the middle alone.
explain fill_box       :: This colours in the whole of a box between two opposite corners, middle and all.
explain draw_circle    :: This colours in a round patch of the given size around a point.
explain reveal_canvas  :: To reveal is to let something be seen. This puts the canvas on the screen in full colour, two rows of dots to every row of the screen.
explain reveal_letters :: This puts the canvas on the screen as letters rather than colour, from a space for the darkest to a hash for the brightest. It works anywhere at all, even where colour does not.
explain a_point        :: A point is a place on the canvas: how far across, then how far down, counting from the top left corner.
explain make_colour    :: A colour is made of three parts, each from nought to two hundred and fifty five: how much red, how much green, and how much blue.
explain named_colour   :: This is the colour that goes by a name, such as red, sky, moss or lamp. It might not work out, because not every name has a colour.
explain canvas_width   :: This is how many dots across the canvas is.
explain canvas_height  :: This is how many dots down the canvas is.
explain colour_at      :: This is the colour of one dot, so a picture can be read as well as drawn.
english across         :: preposition  :: From one side to the other; the way you measure sideways.
english across         :: adverb       :: In the direction that crosses something.
english blue           :: noun         :: The colour of a clear sky, and one of the three a screen mixes.
english box            :: noun         :: A shape with four straight sides and four square corners.
english called         :: verb         :: Named; known by.
english canvas         :: noun         :: The cloth a picture is painted on, and here the surface a program draws on.
english circle         :: noun         :: A round shape, every part of its edge the same distance from the middle.
english clear          :: verb         :: To empty something, or to wipe it back to nothing.
english clear          :: adjective    :: Easy to see through, or easy to understand.
english colour         :: noun         :: What red, green and blue are. Light of a particular sort.
english draw           :: verb         :: To make a picture with lines.
english fill           :: verb         :: To put something into every part of a space until none is left.
english green          :: noun         :: The colour of grass, and one of the three a screen mixes.
english height         :: noun         :: How far something reaches from bottom to top.
english line           :: noun         :: A mark drawn from one place straight to another.
english open           :: verb         :: To make something ready to be used or gone into.
english paint          :: verb         :: To put colour onto a surface.
english point          :: noun         :: One exact place, with no size of its own.
english red            :: noun         :: The colour of blood, and one of the three a screen mixes.
english reveal         :: verb         :: To let something be seen that was hidden.
english width          :: noun         :: How far something reaches from one side to the other.
explain discord_log_in :: This joins Discord as the bot the token belongs to, and waits until it is properly connected before going on. It might not work out, because the token may be wrong or the network may not be there.
explain discord_next   :: This waits, doing nothing, until somebody says something the bot can see, and then goes on. What they said and who said it can be asked for afterwards. The bot never hears itself, so it cannot end up talking to itself forever.
explain discord_reply  :: This answers the message that was just heard, as a reply attached to it, so it is clear what is being answered. It might not work out, because the bot may not be allowed to speak there.
explain discord_send   :: This says something in the same place the last message came from, without attaching it to anything. It might not work out, because the bot may not be allowed to speak there.
explain discord_status :: This is the line people see under the bot's name in the member list.
explain discord_said     :: The words of the message that was just heard.
explain discord_name     :: The name of whoever said it, as it is shown on the server.
explain discord_is_bot   :: Whether whoever said it is a bot rather than a person. Worth checking before answering, so that two bots do not talk to each other all night.
explain discord_channel  :: The name of the channel the message was said in.
explain discord_server   :: The name of the server the message was said in.
explain secret_called    :: A secret kept outside the program, such as a password or a token. Two places are looked in: the surroundings the program was started in, and then a file called .env in the folder it is being run from. The surroundings win, so a secret handed over as you start it beats one written down. It might not work out, because there may be no secret of that name anywhere. Keeping it out here is what lets a program be shown to somebody, or published, without handing them the keys to it.
explain not_decoded    :: Writing that hides what it says is decoded on sight, so that a program means what it looks like it means. This says that one piece of writing is to be left exactly as it is, letter for letter. It is the only way to keep something unreadable, and it shows in the file, which is the point of it.
explain write_text     :: This writes words onto the canvas itself, so a picture can say something without the terminal saying it. Where the letter leaves a dot blank, the picture underneath still shows.
explain letter_size    :: A letter is five dots across and seven down. This says how many dots across each of those dots should be drawn, so writing can be made bigger without a second set of letters.
explain written_width  :: This is how many dots across a line of writing will take up, at the size letters are being drawn. It is how writing is put in the middle of something, or lined up on the right.
explain save_canvas    :: This writes the canvas out as a picture file that any machine can open. It might not work out, because the place may not be writable.
explain put_in_window  :: This puts the canvas in a window of its own rather than in the terminal, and the window keeps up with it by itself. It might not work out, because there may be no way to open a window here.
explain dot_size       :: A dot on the canvas is small. This says how many across it should be drawn in a saved picture or a window, so a small canvas still fills the screen.
english save           :: verb         :: To keep something so that it is not lost.
english window         :: noun         :: An opening that lets you see through; on a screen, a frame with its own picture in it.
english each           :: determiner   :: Every one, thought of separately.
english path           :: noun         :: A way from one place to another; on a machine, where a file is kept.
english size           :: noun         :: How big something is.
english write          :: verb         :: To make letters or words on a surface so that they can be read.
english words          :: noun         :: Units of language; here, the writing that is to be drawn.
english letters        :: noun         :: The written marks that stand for the sounds of a language.
english width          :: noun         :: How far something reaches from one side to the other.
english written        :: adjective    :: Set down in letters rather than spoken. Here, the writing as it would be drawn.
english force          :: verb         :: To make something happen whether or not it would have happened by itself.
english decode         :: verb         :: To turn something written in a code back into what it really says.
english leave          :: verb         :: To let something stay as it is, without touching it.
english exactly        :: adverb       :: In every detail, with nothing altered.
english discord        :: noun         :: A place where people talk to each other in groups, over the internet.
english log            :: verb         :: To record something; to log in is to identify yourself to a machine.
english listen         :: verb         :: To pay attention to sound, waiting for something to be said.
english reply          :: verb         :: To answer something that was said to you.
english send           :: verb         :: To make something go from where you are to somewhere else.
english status         :: noun         :: How things stand with somebody or something at the moment.
english their          :: determiner   :: Belonging to them.
english token          :: noun         :: A thing that stands for something else; here, a secret that proves who a bot is.
english secret         :: noun         :: Something kept from everyone but the few who need it.
english bot            :: noun         :: A program that behaves as though it were a person talking.
english server         :: noun         :: A machine that others connect to; on Discord, one community of people.
english channel        :: noun         :: A way through which things travel; on Discord, one room of a server.
english came           :: verb         :: Moved towards, or arrived from.
english message        :: noun         :: Something said or written, sent from one person to another.
english my             :: determiner   :: Belonging to me.
english they           :: pronoun      :: The people or person being spoken about.
english said           :: verb         :: Spoke; put into words. Also, the words themselves.
english name           :: noun         :: What somebody or something is called.
